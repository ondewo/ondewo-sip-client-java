# Utils image of ondewo-sip-client-java (IMAGE_UTILS_NAME in the Makefile).
#
# Every step of `make build` / `make release` that needs maven, a JDK, gpg, curl or the GitHub CLI runs
# in here, through the *_via_docker targets, so the release host needs only make, git, docker and perl -
# the same split as the utils images of the other ONDEWO clients.
#
# Nothing is copied in: the Makefile MOUNTS the repository at /workspace and runs this image as the
# invoking user (UTILS_DOCKER_RUN), so target/ and pom.xml land in the working tree, owned by that user.
#
# Pinned to the maven and JDK the ondewo-java-proto-compiler image builds the stubs with. JDK 21 compiles
# the maven.compiler.release=11 bytecode of pom.xml, exactly like the JDK 21 job in ci.yml.
# Pinned by DIGEST as well: the tag names maven, but the temurin JDK patch level and the ubuntu
# packages under it move with every rebuild of the tag. Bump tag and digest together:
#   docker buildx imagetools inspect maven:<tag>   (the "Digest:" of the index)
#
# Built with NO context (`docker build -t <name> - < Dockerfile.utils`), so a COPY here fails.
FROM maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320

ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

# make + perl run the Makefile targets, git is used by gh, curl asks the Central Portal whether the user
# token is accepted (check_maven_central_token_valid), and gnupg creates the throwaway key of
# `make dry_run_maven_central` and test-signs with the release key (check_maven_gpg_key_valid). The
# release itself signs with maven-gpg-plugin's pure-java `bc` signer.
RUN apt-get update -qq \
  && apt-get install -y -qq --no-install-recommends make git perl curl ca-certificates gnupg \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# The GitHub CLI at an exact version, from its release tarball, checked against the sha256 recorded
# HERE (the published checksums file sits next to the tarball, so it proves no more than the download).
# Bump all three together: https://github.com/cli/cli/releases/download/v<version>/gh_<version>_checksums.txt
ARG GH_VERSION=2.100.0
ARG GH_SHA256_AMD64=e4d4bb4498e8d007abe545b6568926793ace1b6447da598294a610018cb164be
ARG GH_SHA256_ARM64=ea4e7a581a32ccad6cc7923cb1576ac5859ba4b9a16ab22eb8f8a96e78e2e961
RUN arch="$(dpkg --print-architecture)" \
  && case "$arch" in \
       amd64) sha256="$GH_SHA256_AMD64" ;; \
       arm64) sha256="$GH_SHA256_ARM64" ;; \
       *) echo "no pinned gh build for $arch" >&2; exit 1 ;; \
     esac \
  && curl -fsSL -o /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
  && echo "${sha256}  /tmp/gh.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/gh.tar.gz -C /tmp \
  && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh \
  && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${arch}" \
  && gh --version

WORKDIR /workspace
