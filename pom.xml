<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build descriptor of the ONDEWO SIP java client.

  Everything above the "HAND-WRITTEN" marker below is BUILD OUTPUT: it is rendered by
  ondewo-proto-compiler/java/image-data/make-lib-entry-point.sh from its pom template, with the
  maven coordinates taken from the `docker run` arguments in `make generate_ondewo_protos` and
  every toolchain version from the image ENV (set from the Dockerfile ARGs). That indirection
  guarantees the generated part can never name a version that is absent from the image's
  pre-warmed offline maven repository.

  IMPORTANT: `make generate_ondewo_protos` OVERWRITES this file with a freshly rendered
  template, which does NOT contain the hand-written configuration below. After a
  regeneration, re-apply ALL FOUR HAND-WRITTEN blocks or the client silently stops being
  publishable / testable:
    1. Maven Central metadata  (developers + scm, and the url pointing at THIS repository)
    2. test dependencies       (junit-jupiter + grpc-inprocess)
    3. surefire + jacoco       (the test run and the coverage gate)
    4. javadoc + the release profile (gpg signing + central-publishing)
  `make check_central_pom` fails loudly when block 1 or 4 has been lost, so a regeneration
  cannot silently produce a jar that Maven Central would reject. The permanent fix is to add
  the same blocks to the template in
  ondewo-proto-compiler/java/image-data/default-lib-files/pom.xml.

  NOTE: XML comments may not contain a double hyphen, so protoc/maven flags are spelled
  without their leading dashes throughout this file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ondewo</groupId>
  <artifactId>ondewo-sip-client-java</artifactId>
  <version>5.4.0</version>
  <packaging>jar</packaging>

  <name>ondewo-sip-client-java</name>
  <description>gRPC client stubs generated by the ondewo-proto-compiler</description>
  <!-- HAND-WRITTEN. The rendered template points this at the compiler that produced the
       stubs; Maven Central shows it as the project home page, so it has to name the
       artifact's own repository - the one the scm block below also resolves to. -->
  <url>https://github.com/ondewo/ondewo-sip-client-java</url>

  <organization>
    <name>ONDEWO GmbH</name>
    <url>https://www.ondewo.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <!-- ============ HAND-WRITTEN block 1: Maven Central metadata ============
       `developers` and `scm` are MANDATORY for a Central deployment (together with name,
       description, url and licenses above, which the template already renders). A pom
       missing either is rejected by the Portal's validation AFTER the upload, so
       `make check_central_pom` asserts them before a single byte is sent. -->
  <developers>
    <developer>
      <id>ondewo</id>
      <name>ONDEWO GmbH</name>
      <email>office@ondewo.com</email>
      <organization>ONDEWO GmbH</organization>
      <organizationUrl>https://www.ondewo.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ondewo/ondewo-sip-client-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ondewo/ondewo-sip-client-java.git</developerConnection>
    <url>https://github.com/ondewo/ondewo-sip-client-java</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <grpc.version>1.84.0</grpc.version>
    <protobuf.version>4.33.6</protobuf.version>
    <google.common.protos.version>2.76.0</google.common.protos.version>
    <!-- HAND-WRITTEN. 5.11.x is the last JUnit line that still runs on java 8/11; 5.13+ and
         JUnit 6 require java 17 and would break the JDK 11 half of the CI matrix. -->
    <junit.version>5.11.4</junit.version>
    <surefire.version>3.5.4</surefire.version>
    <jacoco.version>0.8.13</jacoco.version>
    <!-- HAND-WRITTEN. Publishing toolchain; see block 4 below. -->
    <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
    <gpg.plugin.version>3.2.8</gpg.plugin.version>
    <central.plugin.version>0.11.0</central.plugin.version>
    <!-- Coverage is measured over HAND-WRITTEN sources only. The generated stubs are machine
         output, are exercised by the test suite but are not authored logic, and their
         hundreds of thousands of generated lines would drown any real regression. -->
    <handwritten.sources>com/ondewo/sip/auth/**</handwritten.sources>
  </properties>

  <dependencies>
    <!-- message classes generated by protoc's java_out.
         Declared directly (depth 1) so it wins Maven's nearest-definition rule over the
         protobuf-java 3.25.9 that grpc-protobuf pulls transitively: our gencode is 4.32.x
         and protobuf only supports a runtime NEWER than the gencode, never older.
         Never move this into a BOM and never lower the version. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- google/api/annotations.proto, google/rpc/status.proto and google/type/latlng.proto
         are imported by the ondewo protos. Their Java classes are consumed from this jar
         instead of being generated, so they are not duplicated on the consumer classpath.
         Bumping this alone can raise its embedded gencode above protobuf.version and
         poison-pill the runtime - always re-check its protobuf-java version and raise
         protobuf.version to at least match. -->
    <dependency>
      <groupId>com.google.api.grpc</groupId>
      <artifactId>proto-google-common-protos</artifactId>
      <version>${google.common.protos.version}</version>
    </dependency>
    <!-- service stubs generated by protoc's grpc-java_out -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!-- transport, so the published library is usable without extra wiring -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- ============ HAND-WRITTEN block 2: test dependencies ============ -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The in-process transport lets the suite drive a generated stub against a real server
         over the real marshallers, with no socket and no network. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <version>${grpc.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Not part of the default lifecycle, so the version must be explicit for the
           offline resolution to find it in the pre-warmed local repository. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- ============ HAND-WRITTEN block 3: test run + coverage gate ============ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- Instrument and report on the hand-written package only. An `includes` filter,
               not an `excludes` one, so a newly generated package can never silently start
               counting towards the gate. -->
          <includes>
            <include>${handwritten.sources}</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- The gate. Bound to `verify`, so `mvn verify` in CI fails when hand-written
               coverage drops below 100 percent. -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                    <limit>
                      <counter>METHOD</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                    <limit>
                      <counter>CLASS</counter>
                      <value>MISSEDCOUNT</value>
                      <maximum>0</maximum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ============ HAND-WRITTEN block 4a: the javadoc jar ============
           Maven Central rejects a deployment that carries no javadoc jar, so this is part of
           the normal `verify` - NOT of the release profile below. A javadoc break then fails
           CI on the commit that caused it, instead of during a release.

           doclint none: the sources are protoc output. The generator does not write javadoc
           that satisfies the JDK 8+ doclint (missing @param/@return, self-closing tags), and
           there is nothing to fix in machine-generated text. failOnError stays at its default
           `true`, so a REAL javadoc failure (a source that does not parse) is still loud.

           detectJavaApiLink/detectOfflineLinks false: both make javadoc reach out to
           docs.oracle.com for the JDK element list. The build must stay hermetic, because it
           also has to pass with maven in offline mode (make dry_run_maven_central). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${javadoc.plugin.version}</version>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
          <detectJavaApiLink>false</detectJavaApiLink>
          <detectOfflineLinks>false</detectOfflineLinks>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- ============ HAND-WRITTEN block 4b: the release profile ============
       Signing and publishing live in a profile so that a plain `mvn verify` - what every
       developer and the CI build job runs - needs neither a GPG key nor a Portal token.

       `mvn Prelease verify`  signs everything and publishes NOTHING (the publish goal is
                              bound to `deploy`). That is the credential-free rehearsal CI
                              runs with a throwaway key: see `make dry_run_maven_central`.
       `mvn Prelease deploy`  is the only command that uploads. See `make publish_to_maven_central`. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- Central requires a detached PGP signature next to every artifact.
               signer `bc`: the pure-java BouncyCastle signer, so no gpg binary, no keyring
               and no gpg-agent has to exist in the container or the runner. It takes the
               ASCII-armored secret key from MAVEN_GPG_KEY and the passphrase from
               MAVEN_GPG_PASSPHRASE, which is also why bestPractices can be on: neither
               secret is ever a pom value, a settings.xml value or a command line argument. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <signer>bc</signer>
                  <bestPractices>true</bestPractices>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- extensions=true replaces maven-deploy-plugin in the `deploy` phase, so `deploy`
               uploads a Portal bundle instead of trying to write to a distributionManagement
               repository this pom deliberately does not declare.
               autoPublish=false: the deployment is validated and then WAITS in the Portal for
               a human to press Publish. Releasing to Central is irreversible - a version can
               never be replaced or withdrawn - so the last step stays manual on purpose.
               Credentials are read from the `central` server of the settings.xml that
               maven-central-settings.xml interpolates out of the environment. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <deploymentName>${project.groupId}:${project.artifactId}:${project.version}</deploymentName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
